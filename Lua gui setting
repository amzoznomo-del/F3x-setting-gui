-- FUNCTION 2: Skybox
-- ==========================================
createButton("skybox", 155, function(id)
    task.spawn(function()
        pcall(function()
            local rc = ReplicatedStorage:WaitForChild("HDAdminHDClient", 2)
            if rc and rc:FindFirstChild("Signals") and rc.Signals:FindFirstChild("RequestCommandSilent") then
                rc.Signals.RequestCommandSilent:InvokeServer(";fogcolor black")
            end
        end)
        
        local tool = player.Backpack:FindFirstChild("Building Tools") or (player.Character and player.Character:FindFirstChild("Building Tools"))
        local remote = tool and tool:FindFirstChild("SyncAPI") and tool.SyncAPI:FindFirstChild("ServerEndpoint")
        if not remote then
            local r = getF3XRemote()
            if r then remote = r else return end
        end
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local pos = char.HumanoidRootPart.Position + Vector3.new(1, 10, 0)
        local cleanCF = CFrame.new(pos)  
        
        remote:InvokeServer("CreatePart", "Normal", cleanCF, workspace) 
        task.wait(0.5) 
        
        local customSize = parseVector3(skyboxSizeBox.Text, Vector3.new(1500, 1500, 1500))
        
        for _, v in pairs(workspace:GetChildren()) do     
            if v:IsA("BasePart") and (v.Position - pos).Magnitude < 5 then         
                remote:InvokeServer("SyncMove", {{["Part"] = v, ["CFrame"] = cleanCF}})         
                remote:InvokeServer("CreateMeshes", {{["Part"] = v}})         
                remote:InvokeServer("SyncMesh", {{["Part"] = v, ["MeshId"] = "rbxassetid://111891702759441", ["TextureId"] = "rbxassetid://" .. id, ["Scale"] = customSize}})         
                remote:InvokeServer("SetName", {v}, "SkyBox_Z")         
                remote:InvokeServer("SetLocked", {v}, true)     
            end 
        end
    end)
end)

-- ==========================================
-- FUNCTION 3: Skybox Spin
-- ==========================================
createButton("skybox spin", 195, function(id)
    task.spawn(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local tool
        for _, obj in player:GetDescendants() do
            if obj.Name == "SyncAPI" then tool = obj.Parent break end
        end
        if not tool then
            for _, obj in ReplicatedStorage:GetDescendants() do
                if obj.Name == "SyncAPI" then tool = obj.Parent break end
            end
        end
        if not tool or not tool:FindFirstChild("SyncAPI") then return end
        local SyncAPI = tool.SyncAPI
        
        local part, baseCF
        local angle = 0
        local connection
        
        local function invokeArgs(args)
            pcall(function() SyncAPI:Invoke(unpack(args)) end)
        end
        
        local startCF = hrp.CFrame + Vector3.new(0, 6, 0)
        invokeArgs({"CreatePart", "Normal", startCF, workspace})
        
        task.wait(0.2)
        for _, obj in workspace:GetDescendants() do
            if obj:IsA("BasePart") and (obj.Position - startCF.Position).Magnitude < 1 then
                part = obj
                baseCF = part.CFrame
                invokeArgs({"SyncAnchor", {{["Part"] = part, ["Anchored"] = true}}})
                invokeArgs({"CreateMeshes", {{["Part"] = part}}})
                invokeArgs({"SyncMesh", {{["Part"] = part, ["MeshId"] = "rbxassetid://111891702759441"}}})
                invokeArgs({"SyncMesh", {{["Part"] = part, ["TextureId"] = "rbxassetid://" .. id}}})
                
                local customSpinSize = parseVector3(spinSizeBox.Text, Vector3.new(1500, 1500, 1500))
                invokeArgs({"SyncMesh", {{["Part"] = part, ["Scale"] = customSpinSize}}})
                invokeArgs({"SyncTransparency", {{["Part"] = part, ["Transparency"] = 0}}})
                
                local angX, angY = 0, 0
                local success, ax, ay = pcall(function()
                    local split = string.split(spinAngleBox.Text, ",")
                    return tonumber(split[1]) or 0, tonumber(split[2]) or 0
                end)
                if success then
                    angX, angY = ax, ay
                end
                
                local rotation = math.rad(20)
                connection = RunService.Heartbeat:Connect(function(dt)
                    if not part or not part.Parent then
                        if connection then connection:Disconnect() connection = nil end
                        return
                    end
                    angle = angle + (rotation * dt)
                    local cf = baseCF * CFrame.Angles(angX, angle + angY, 0)
                    pcall(function()
                        SyncAPI:Invoke("SyncRotate", {{["Part"] = part, ["CFrame"] = cf}})
                    end)
                    part.CFrame = cf
                end)
                break
            end
        end
    end)
end)

