-- FUNCTION 4: Particle
-- ==========================================
createButton("particle", 235, function(id)
    task.spawn(function()
        local remote = getF3XRemote()
        if not remote then return end
        
        local function sendArgs(args)
            pcall(function() remote:InvokeServer(unpack(args)) end)
        end
        
        local pSize = particleSizeBox.Text ~= "" and particleSizeBox.Text or "1"
        local pSpeed = tonumber(particleSpeedBox.Text) or 5
        local pRate = tonumber(particleRateBox.Text) or 50
        local pLifetime = tonumber(particleLifetimeBox.Text) or 120
        local pSpread = tonumber(particleSpreadBox.Text) or 50
        local pLightEm = tonumber(particleLightEmissionBox.Text) or 1
        local pLightInf = tonumber(particleLightInfluenceBox.Text) or 0
        
        local function processPart(p)
            if p:IsA("BasePart") then
                task.spawn(function()
                    sendArgs({"CreateDecorations", {{["Part"] = p, ["DecorationType"] = "ParticleEmitter"}}})
                    task.wait(0.05)
                    sendArgs({"SyncDecorate", {{
                        ["Part"] = p,
                        ["DecorationType"] = "ParticleEmitter",
                        ["Texture"] = "rbxassetid://" .. id,
                        ["Size"] = pSize,
                        ["Speed"] = pSpeed,
                        ["Rate"] = pRate,
                        ["Lifetime"] = pLifetime,
                        ["SpreadAngle"] = pSpread,
                        ["LightEmission"] = pLightEm,
                        ["LightInfluence"] = pLightInf
                    }}})
                end)
            end
        end
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            processPart(obj)
        end
    end)
end)
