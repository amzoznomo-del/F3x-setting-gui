end

local function parseVector3(str, defaultVec)
    local success, x, y, z = pcall(function()
        local split = string.split(str, ",")
        return tonumber(split[1]), tonumber(split[2]), tonumber(split[3])
    end)
    if success and x and y and z then
        return Vector3.new(x, y, z)
    end
    return defaultVec
end

